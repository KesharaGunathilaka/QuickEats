# Production settings for docker-compose.prod.yml.
# Copy to .env.prod on the server and replace every CHANGE_ME value.
# .env.prod is git-ignored — never commit it.

# ── Images ──
# Registry + account the images were pushed to, e.g. docker.io/yourname or ghcr.io/yourname
IMAGE_PREFIX=docker.io/CHANGE_ME
# Fallback only — the Jenkins pipeline deploys the git SHA tag and overrides this.
IMAGE_TAG=latest

# ── Database ──
# Must be URL-safe (it goes inside connection URLs). Generate with: openssl rand -hex 24
# Only applied when the Postgres volume is first created.
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24

# ── JWT ──
# Use a different secret from your local .env. Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48

# ── Payment Gateway ──
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

# ── Admin dashboard (http://<server>/admin) ──
# Created on first start if no account with this email exists. Password: 8+ characters.
# Changing these later does not change an existing admin's password.
ADMIN_EMAIL=CHANGE_ME@example.com
ADMIN_PASSWORD=CHANGE_ME_long_random_password
