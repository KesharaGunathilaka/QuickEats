# ── Database ──
# Each service has its own Postgres server (docker-compose.yml), one host port each.
IDENTITY_DB_URL=postgres://identity:identity@localhost:5433/identity_db?sslmode=disable
CATALOG_DB_URL=postgres://catalog:catalog@localhost:5434/catalog_db?sslmode=disable
ORDER_DB_URL=postgres://order:order@localhost:5435/order_db?sslmode=disable
PAYMENT_DB_URL=postgres://payment:payment@localhost:5436/payment_db?sslmode=disable

# ── Redis ──
REDIS_URL=localhost:6379

# ── Kafka ──
KAFKA_BROKERS=localhost:9092

# ── JWT ──
# Secret used to sign and verify login tokens. Shared by all services.
# 1. Copy this file to .env (same folder). .env is git-ignored — never commit it.
# 2. Generate a random secret (at least 32 characters) and paste it below in .env:
#      Git Bash / macOS / Linux:  openssl rand -base64 48
#      PowerShell:                [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }) -as [byte[]])
# 3. Never reuse the example value or share your real secret in chat, commits or screenshots.
# Changing the secret logs every user out (existing tokens become invalid).
JWT_SECRET=CHANGE_ME_generate_a_random_secret_see_instructions_above
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Firebase ──
FIREBASE_CREDENTIALS_PATH=

# ── Service Ports ──
IDENTITY_PORT=8081
CATALOG_PORT=8082
ORDER_PORT=8083
PAYMENT_PORT=8084
NOTIFICATION_HTTP_PORT=8085
NOTIFICATION_WS_PORT=8086
