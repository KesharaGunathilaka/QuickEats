# ── Database ──
IDENTITY_DB_URL=postgres://quickeats:quickeats@localhost:5432/identity_db?sslmode=disable
CATALOG_DB_URL=postgres://quickeats:quickeats@localhost:5432/catalog_db?sslmode=disable
ORDER_DB_URL=postgres://quickeats:quickeats@localhost:5432/order_db?sslmode=disable
PAYMENT_DB_URL=postgres://quickeats:quickeats@localhost:5432/payment_db?sslmode=disable

# ── Redis ──
REDIS_URL=localhost:6379

# ── NATS ──
NATS_URL=nats://localhost:4222

# ── JWT ──
JWT_SECRET=change-me-in-production-use-a-256-bit-key
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Payment Gateway ──
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true

# ── Firebase ──
FIREBASE_CREDENTIALS_PATH=

# ── Service Ports ──
IDENTITY_PORT=8081
CATALOG_PORT=8082
ORDER_PORT=8083
PAYMENT_PORT=8084
NOTIFICATION_HTTP_PORT=8085
NOTIFICATION_WS_PORT=8086
