.env
.env.*

# VCS, editors, OS
.git
.gitignore
.vscode
.idea
**/.DS_Store
**/Thumbs.db

# Not needed inside images
infra
docker-compose*.yml
Makefile
**/*.md
**/*_test.go
**/migrations

# Build output
bin
dist
**/*.exe

# Stray folder from a failed mkdir (path too long to read)
{pkg*

# Deploy scripts run on the host, not in images
deploy
Jenkinsfile
